# Salin file ini jadi .env lalu isi sesuai kebutuhan.
# Tanpa GROQ_API_KEY / GEMINI_API_KEY, tool otomatis pakai fallback lokal (whisper.cpp / Ollama).

# Transkrip — Groq Whisper API (utama)
GROQ_API_KEY=

# Transkrip — whisper.cpp lokal (cadangan)
WHISPER_CPP_BIN=/usr/local/bin/whisper-cli
WHISPER_CPP_MODEL=/usr/local/share/whisper/ggml-small-q5_1.bin

# Pemilihan momen — Gemini Flash (utama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Pemilihan momen — Ollama lokal (cadangan)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
